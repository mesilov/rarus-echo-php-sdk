# Keep the distributed Composer/Packagist package lean: exclude development,
# CI, build tooling, docs process, and agent/maintainer files from the dist
# archive (`git archive`, which Packagist uses for dist zipballs). Consumers
# receive only the runtime SDK: src/, composer.json, LICENSE, README, CHANGELOG
# and the published CLI in bin/.

# Keep public installer bytes identical to raw main on every native platform.
*.sh text eol=lf
*.ps1 text eol=lf

# Build identity hashes raw bytes and must agree across native platforms.
/build/config.json text eol=lf
/build/compression.json text eol=lf
/build/compression-patches/*.json text eol=lf
/build/licenses/* text eol=lf
/build/media/** text eol=lf
/build/media/*.asc text eol=lf
/tests/Fixtures/Media/*.mp4 -text
/tests/Fixtures/Media/*.mkv -text
/tests/Fixtures/Media/*.webm -text
/tests/Fixtures/Media/*.m4a -text
/tests/Fixtures/Media/*.mp3 -text
/tests/Fixtures/Media/*.wav -text
/tests/Fixtures/Media/*.json text eol=lf
/tests/Fixtures/Media/*.py text eol=lf
/build/patches/*.json text eol=lf
/docker/rarus-echo-cli/composer.lock text eol=lf

# Development-only paths excluded from the distributed package.
/.agent-plugins        export-ignore
/.agents               export-ignore
/.claude               export-ignore
/.claude-plugin        export-ignore
/.codex                export-ignore
/.github               export-ignore
/build                 export-ignore
/docker                export-ignore
/openspec              export-ignore
/tests                 export-ignore
/.dockerignore         export-ignore
/.env                  export-ignore
/.gitattributes        export-ignore
/.gitignore            export-ignore
/.php-cs-fixer.dist.php export-ignore
/AGENTS.md             export-ignore
/CLAUDE.md             export-ignore
/CONTRIBUTING.md       export-ignore
/Makefile              export-ignore
/docker-compose.yaml   export-ignore
/install.sh            export-ignore
/install.ps1           export-ignore
/phpstan.neon.dist     export-ignore
/phpunit.xml.dist      export-ignore
/rector.php            export-ignore
