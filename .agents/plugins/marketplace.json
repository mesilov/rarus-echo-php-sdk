{
  "name": "rarus-echo-plugins",
  "description": "Repository-local RARUS Echo agent plugins.",
  "interface": {
    "displayName": "RARUS Echo Plugins"
  },
  "owner": {
    "name": "RARUS Echo PHP SDK maintainers"
  },
  "plugins": [
    {
      "name": "rarus-echo-transcription",
      "source": {
